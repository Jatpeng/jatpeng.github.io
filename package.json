{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "cms:build": "set -a; [ -f .env.local ] && . ./.env.local; set +a; tinacms build",
    "cms:dev": "set -a; [ -f .env.local ] && . ./.env.local; set +a; tinacms dev -c \"hexo server\"",
    "deploy": "hexo deploy",
    "server": "hexo server"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-asset-image": "^1.0.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "^5.3.2",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-theme-next": "^8.22.0",
    "leancloud-realtime": "^5.0.0-rc.8",
    "leancloud-storage": "^4.15.0",
    "valine": "^1.5.1"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.1.5",
    "tinacms": "^2.6.0"
  }
}
